# Foundry MCP (headless) — environment configuration
#
# Copy this to a gitignored `.env` in the repo root and fill in YOUR instance's values.
# config.ts reads every variable below; anything left unset falls back to the neutral
# placeholders/defaults shown here. Real values (and ALL secrets) belong only in .env.

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=simple
ENABLE_FILE_LOGGING=false
# LOG_FILE_PATH=./logs/mcp-server.log
# TOOL_RESPONSE_MAX_CHARS=20000

# =============================================================================
# MCP server identity
# =============================================================================
SERVER_NAME=foundry-mcp-server
# SERVER_VERSION=1.0.0

# =============================================================================
# Headless Foundry bridge (Plane A — src/foundry.ts)
# =============================================================================
# Your world's base URL, e.g. https://your-server.moltenhosting.com
MOLTEN_SERVER_URL=https://your-server.moltenhosting.com
# The world's id (folder name under Data/worlds; this is the "molten id"). With MOLTEN_ADMIN_KEY set,
# the bridge will remote-LAUNCH this world if it finds the box up but no world active. Leave unset to
# keep world-launch a manual step (the bridge then tells you to launch it instead of trying).
# TIP: you don't need to be told the world id — read it over WebDAV. PROPFIND Depth:1
#   https://<box>.webdav.moltenhosting.com/Data/worlds/  (Basic auth: foundry-ftp / File-Manager pw)
# and every collection under worlds/ (other than README.txt) is a world id. An empty worlds/ means the
# box is fresh with no world yet.
MOLTEN_WORLD_ID=your-world
# Dedicated Foundry user the headless client joins as.
FOUNDRY_USER=MCP-Claude
# That user's password. Leave unset/blank for a passwordless user.
# FOUNDRY_PASSWORD=
# Molten "Server Startup / Magic URL" (…?s=token) — GET to wake a sleeping box before joining.
# Optional but recommended; without it the box must already be awake. Read it from the Molten panel.
# MOLTEN_MAGIC_URL=

# =============================================================================
# Molten file tools (Plane B — WebDAV, the molten host's file plane; DESIGN §4/§6)
# =============================================================================
MOLTEN_WEBDAV_URL=https://your-server.webdav.moltenhosting.com
MOLTEN_FILEBROWSER_URL=https://your-server.files.moltenhosting.com
# Identical for every Molten instance:
MOLTEN_WEBDAV_USER=foundry-ftp

# =============================================================================
# SECRETS — read once from the Molten panel (Server Details), NEVER commit.
# Leave blank here; set the real values only in your gitignored .env.
# Each tool reports which variable to set if its secret is missing.
# =============================================================================
MOLTEN_WEBDAV_PASSWORD=    # upload-asset / asset file ops: File Manager password (user = foundry-ftp)
MOLTEN_ADMIN_KEY=          # Foundry "Default Administrator Password" (admin access key).
                           # With MOLTEN_WORLD_ID, lets the bridge remote-launch a world on a cold box.

# =============================================================================
# Local sandbox (scripts/pull-prod-to-local.mjs — see docs/local-sandbox.md)
# =============================================================================
# The LOCAL Foundry install's Data directory that prod gets mirrored into (the pull script's --to
# flag overrides it; with neither set the script refuses to run). For FOUNDRY_HOST=local this same
# directory is the asset file tools' file plane.
# LOCAL_FOUNDRY_DATA=C:\Users\you\AppData\Local\FoundryVTT\Data

# =============================================================================
# Hosts — where THIS server process's Foundry runs (design.md §2.6, docs/local-sandbox.md)
# =============================================================================
# FOUNDRY_HOST selects the host. It is set in the MCP server REGISTRATION's env block (one
# registration per instance), NOT here — this one .env serves every host. (The pre-2.2 spelling
# FOUNDRY_PROFILE=local is still honoured as an alias of FOUNDRY_HOST=local.)
#
#   molten  (default) — Molten Hosting: the MOLTEN_* set above. Wakes a sleeping box through
#                       MOLTEN_MAGIC_URL; the asset file tools use WebDAV (MOLTEN_WEBDAV_PASSWORD).
#   local             — a Foundry install on THIS machine (the sandbox mirrored from prod by
#                       scripts/pull-prod-to-local.mjs): the LOCAL_* set below. No wake (a local
#                       box does not sleep); the asset file tools work straight on the install's
#                       Data directory (LOCAL_FOUNDRY_DATA — unset = they report "not configured").
#   generic           — any Foundry at a URL, nothing else known: FOUNDRY_URL (+ FOUNDRY_ADMIN_KEY /
#                       FOUNDRY_WORLD_ID for a remote world launch). No wake, no file plane.
#
# The local host inherits MOLTEN_WORLD_ID and FOUNDRY_USER/_PASSWORD (a sandbox is a byte copy of
# prod — same world id, same users) and never dials prod's file plane from a local process.
# LOCAL_SERVER_URL=http://localhost:30000
# LOCAL_WORLD_ID=            # only if it should differ from MOLTEN_WORLD_ID
# LOCAL_FOUNDRY_USER=        # only if it should differ from FOUNDRY_USER
# LOCAL_FOUNDRY_PASSWORD=    # only if it should differ from FOUNDRY_PASSWORD
# LOCAL_ADMIN_KEY=           # local admin password — required by scripts/local-foundry.mjs for
#                            # world launch AND graceful stop (the launcher passes it at boot, so
#                            # Config/admin.txt always matches this value). Unset = click Play yourself.
# LOCAL_FOUNDRY_APP=         # path to the installed app's resourcesappmain.js — only if it
#                            # differs from C:Program FilesFoundry Virtual Tabletopesourcesappmain.js
# FOUNDRY_TOOLSETS=          # optional, per REGISTRATION like FOUNDRY_HOST: a comma list of toolsets to
#                            # advertise (world,actors,items,compendium,scenes,journals,tables,cards,
#                            # audio,chat,combat,assets,organization). Unset = all; world is always on.
# FOUNDRY_URL=               # generic host only: the instance's base URL
# FOUNDRY_ADMIN_KEY=         # generic host only
# FOUNDRY_WORLD_ID=          # generic host only
