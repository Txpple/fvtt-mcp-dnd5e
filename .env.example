# fvtt-mcp-dnd5e — environment configuration
#
# Copy this to a gitignored `.env` in the repo root and fill in YOUR instance's values. Secrets
# (passwords, the admin key, a wake token) belong only in .env — never in a tracked file.
#
# One variable set, the same on every host: FOUNDRY_*. The MCP registration's `env` block beats
# this file, so one .env can serve several registrations (a prod box and a local sandbox), each
# registration setting only what differs (FOUNDRY_HOST, FOUNDRY_URL, ...).

# =============================================================================
# The Foundry instance (src/hosts/env.ts — the one env selector)
# =============================================================================
# REQUIRED: the instance's base URL. The placeholder is refused at startup.
FOUNDRY_URL=https://your-foundry.example.com
# The dedicated user the headless client joins as. Create it in Foundry (Users → Create User),
# role Gamemaster or Assistant GM. Default MCP-Claude.
FOUNDRY_USER=MCP-Claude
# That user's password; leave unset/blank for a passwordless user.
# FOUNDRY_PASSWORD=
# Foundry's admin access key ("Default Administrator Password"). With it the bridge launches a
# world by itself when it finds the instance up but no world active. Unset = launch it yourself.
# FOUNDRY_ADMIN_KEY=
# Which world to launch. Unset = the ONE world /setup lists is launched; set it when there are
# several (the folder name under Data/worlds/).
# FOUNDRY_WORLD_ID=
# A URL a GET of which wakes a sleeping instance (Molten's "Server Startup / Magic URL",
# `…?s=token`). Optional; without it the instance must already be awake. Redacted in logs.
# FOUNDRY_WAKE_URL=

# =============================================================================
# The host preset — set in the MCP registration's env block, not here
# =============================================================================
# FOUNDRY_HOST picks how the instance is reached (design.md §2.6). Default `generic`.
#
#   generic  — any Foundry at a URL. Reads every variable in this file.
#   molten   — Molten Hosting: the WebDAV file plane's URL and user are derived from FOUNDRY_URL
#              (`https://<box>.moltenhosting.com` → `…<box>.webdav…`, user foundry-ftp), so only
#              FOUNDRY_WEBDAV_PASSWORD is needed. Never a filesystem plane (a remote box).
#   local    — a Foundry install on THIS machine (docs/local-sandbox.md): FOUNDRY_URL defaults to
#              http://localhost:30000, no wake (a local process does not sleep), never WebDAV.
#
# FOUNDRY_TOOLSETS — also per registration: a comma list of toolsets to advertise (world,actors,
# items,compendium,scenes,journals,tables,cards,audio,chat,combat,assets,organization). Unset = all.

# =============================================================================
# The file plane (the asset file tools — upload-asset, list-assets, ...; design.md §2.6)
# =============================================================================
# Without one of these the asset file tools say so, by name.
#
# The install's Data/ directory, when the instance runs on this machine (local, generic).
# FOUNDRY_DATA_DIR=C:\Users\you\AppData\Local\FoundryVTT\Data
# A WebDAV endpoint over Data/ (molten, generic). molten derives the URL and user (above).
# FOUNDRY_WEBDAV_URL=
# FOUNDRY_WEBDAV_USER=
# FOUNDRY_WEBDAV_PASSWORD=     # Molten: the File Manager password from the panel

# =============================================================================
# Logging / server identity
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=simple
ENABLE_FILE_LOGGING=false
# LOG_FILE_PATH=./logs/mcp-server.log
# TOOL_RESPONSE_MAX_CHARS=20000
SERVER_NAME=foundry-mcp-server
# SERVER_VERSION=1.0.0

# =============================================================================
# Local sandbox launcher (scripts/local-foundry.mjs, scripts/pull-prod-to-local.mjs)
# =============================================================================
# LOCAL_FOUNDRY_APP=           # the installed app's resources\app\main.js — only if it differs
#                              # from C:\Program Files\Foundry Virtual Tabletop\resources\app\main.js

# =============================================================================
# Legacy names (2.x) — still read, each logged once at startup as an alias; rename when convenient
# =============================================================================
# Under FOUNDRY_HOST=molten:  MOLTEN_SERVER_URL → FOUNDRY_URL · MOLTEN_MAGIC_URL → FOUNDRY_WAKE_URL ·
#   MOLTEN_ADMIN_KEY / MOLTEN_WORLD_ID → FOUNDRY_* · MOLTEN_WEBDAV_URL / _USER / _PASSWORD →
#   FOUNDRY_WEBDAV_*. (MOLTEN_FILEBROWSER_URL was never read and is dropped.)
# Under FOUNDRY_HOST=local:   LOCAL_SERVER_URL → FOUNDRY_URL · LOCAL_ADMIN_KEY / LOCAL_WORLD_ID →
#   FOUNDRY_* · LOCAL_FOUNDRY_USER / LOCAL_FOUNDRY_PASSWORD → FOUNDRY_USER / _PASSWORD ·
#   LOCAL_FOUNDRY_DATA → FOUNDRY_DATA_DIR.
# FOUNDRY_PROFILE=local → FOUNDRY_HOST=local.
# An alias wins over the canonical name under its own host, which is what lets one 2.x-layout
# .env (MOLTEN_* for prod, LOCAL_* for the sandbox) keep serving two registrations unchanged.
