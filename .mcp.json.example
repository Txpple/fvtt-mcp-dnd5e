{
  "_comment": "Copy this to a .mcp.json that Claude Code reads (your project root, or merge into ~/.claude.json mcpServers), then set ABSOLUTE paths. One registration per Foundry instance: its env block names the instance and beats the shared .env. On Windows point command at the full node.exe path if Node is not on PATH. The .mcp.json itself is gitignored.",
  "mcpServers": {
    "foundry": {
      "command": "C:/Program Files/nodejs/node.exe",
      "args": ["C:/Users/<you>/path/to/fvtt-mcp-dnd5e/dist/index.js"],
      "env": { "FOUNDRY_URL": "https://your-box.example.com" }
    },
    "foundry-sandbox": {
      "command": "C:/Program Files/nodejs/node.exe",
      "args": ["C:/Users/<you>/path/to/fvtt-mcp-dnd5e/dist/index.js"],
      "env": { "FOUNDRY_HOST": "local" }
    }
  }
}
